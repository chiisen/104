// 站點流水號標籤。數字來自根目錄 _config.yml 的 site_serial，不是 Hexo 框架版號。
.site-title {
  align-items: center;
  display: inline-flex;
  flex-wrap: wrap;
  gap: 8px;
  justify-content: center;
}

.site-serial-tag {
  background: rgba(31, 111, 235, 0.12);
  border: 1px solid rgba(31, 111, 235, 0.35);
  border-radius: 999px;
  color: #1f6feb;
  font-family: $font-family-base;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.02em;
  line-height: 1.4;
  padding: 2px 8px;
  vertical-align: middle;
}
